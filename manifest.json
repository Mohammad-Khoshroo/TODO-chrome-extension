{
    "manifest_version": 3,
    "name": "Fridge Sticky Notes",
    "version": "2.0.0",
    "description": "colorfull notes",
    "icons": {
        "16": "images/stick-note.ico",
        "32": "images/stick-note.ico",
        "48": "images/stick-note.ico",
        "128": "images/stick-note.ico"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "storage"
    ]
}